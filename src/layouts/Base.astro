---
import '@fontsource/atkinson-hyperlegible/latin-400.css';
import '@fontsource/atkinson-hyperlegible/latin-700.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-600.css';
import '../styles/global.css';
import { SITE, repoIssueUrl } from '../config';
import SearchBox from '../components/SearchBox.astro';

interface Props { title?: string; description?: string; hideHeaderSearch?: boolean; wide?: boolean }
const { title, description = SITE.tagline, hideHeaderSearch = false, wide = false } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name}: DevOps tools and AI prompts that mask your secrets`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const path = Astro.url.pathname;
const nav = [
  { href: '/tools/', label: 'Tools' },
  { href: '/cheatsheets/', label: 'Cheatsheets' },
  { href: '/prompts/', label: 'Prompts' },
];
const { kofi, githubSponsors } = SITE.support;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#eef1f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111a27" media="(prefers-color-scheme: dark)" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <script is:inline>
      try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap hbar">
        <a class="logo" href="/" aria-label={`${SITE.name} home`}>ops<span class="bar">mask</span></a>
        <nav aria-label="Main">
          {nav.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        {!hideHeaderSearch && (
          <div class="header-search"><SearchBox id="header-search" placeholder="Search  ( / )" /></div>
        )}
        <div class="right">
          <a class="icon-btn" href={SITE.repo} rel="noopener" aria-label="Source code on GitHub" title="Source on GitHub">
            <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.72 1.22 1.87.87 2.33.66.07-.52.28-.87.5-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.83-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
          </a>
          {kofi && (
            <a class="support" href={kofi} rel="noopener">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M4 5h13a3 3 0 0 1 0 6h-.3A6 6 0 0 1 11 16H9a6 6 0 0 1-6-6V6a1 1 0 0 1 1-1Zm13 4a1 1 0 0 0 0-2v2ZM3 19h15v2H3z"/></svg>
              <span>Support</span>
            </a>
          )}
          <button class="icon-btn theme-toggle" type="button" aria-label="Switch light or dark theme" title="Light / dark">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 3a9 9 0 1 0 9 9A9 9 0 0 0 12 3Zm0 16V5a7 7 0 0 1 0 14Z"/></svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main" class:list={['wrap', { wide }]}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap foot">
        <div class="col about">
          <a class="logo" href="/">ops<span class="bar">mask</span></a>
          <p>Tools, cheatsheets and AI prompts for people who run infrastructure. Every tool runs in your browser, and the site’s security policy blocks pages from sending your input anywhere.</p>
        </div>
        <div class="col">
          <h2>Contribute</h2>
          <ul>
            <li><a href={SITE.repo} rel="noopener">Source code on GitHub</a></li>
            <li><a href={repoIssueUrl('tool_request.yml')} rel="noopener">Request a tool</a></li>
            <li><a href={repoIssueUrl('prompt_submission.yml')} rel="noopener">Submit a prompt</a></li>
            <li><a href={repoIssueUrl('bug_report.yml')} rel="noopener">Report a bug</a></li>
          </ul>
        </div>
        <div class="col">
          <h2>Support</h2>
          <ul>
            {kofi && <li><a href={kofi} rel="noopener">Buy me a coffee on Ko-fi</a></li>}
            {githubSponsors && <li><a href={githubSponsors} rel="noopener">GitHub Sponsors</a></li>}
            <li><a href={SITE.repo} rel="noopener">Star the repo</a></li>
            <li><a href="/about/">About and privacy</a></li>
          </ul>
        </div>
      </div>
      <div class="wrap legal">© {year} {SITE.name}. Code under the MIT License.</div>
    </footer>

    <script>
      const root = document.documentElement;
      document.querySelector('.theme-toggle')?.addEventListener('click', () => {
        const current = root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
      });

      document.addEventListener('keydown', (e) => {
        const typing = (e.target as HTMLElement).closest('input, textarea, select, [contenteditable]');
        if ((e.key === '/' && !typing) || (e.key.toLowerCase() === 'k' && (e.metaKey || e.ctrlKey))) {
          const input = document.querySelector<HTMLInputElement>('#hero-search, #header-search');
          if (input && input.offsetParent !== null) { e.preventDefault(); input.focus(); input.select(); }
        }
      });

      document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
        const btn = document.createElement('button');
        btn.className = 'copy-btn';
        btn.type = 'button';
        btn.textContent = 'Copy';
        btn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? pre.innerText);
            btn.textContent = 'Copied';
          } catch { btn.textContent = 'Press Ctrl+C'; }
          setTimeout(() => (btn.textContent = 'Copy'), 1500);
        });
        pre.appendChild(btn);
      });
    </script>

    <style>
      .skip { position: absolute; left: -999px; }
      .skip:focus { left: 1rem; top: 1rem; z-index: 99; background: var(--surface); padding: 0.5rem 1rem; }
      .site-header { border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: blur(8px); position: sticky; top: 0; z-index: 20; }
      .hbar { display: flex; align-items: center; gap: 1.5rem; padding-block: 0.65rem; flex-wrap: wrap; }
      nav { display: flex; gap: 1.1rem; }
      nav a { color: var(--ink-soft); text-decoration: none; font-weight: 700; padding-block: 0.2rem; }
      nav a:hover, nav a[aria-current='page'] { color: var(--ink); }
      nav a[aria-current='page'] { box-shadow: inset 0 -3px 0 var(--mask); }
      .header-search { margin-left: auto; width: 300px; }
      .header-search :global(input) { padding-block: 0.45rem; font-size: 0.95rem; }
      .right { display: flex; align-items: center; gap: 0.5rem; }
      .hbar > nav + .right { margin-left: auto; }
      .icon-btn { background: none; border: 1px solid var(--line); color: var(--ink); border-radius: var(--radius-m); width: 2.25rem; height: 2.25rem; display: grid; place-items: center; cursor: pointer; }
      .icon-btn:hover { background: var(--surface); }
      .support { display: inline-flex; align-items: center; gap: 0.35rem; height: 2.25rem; padding: 0 0.75rem; border-radius: var(--radius-m); border: 1px solid var(--line); color: var(--ink); font-weight: 700; font-size: 0.95rem; text-decoration: none; }
      .support:hover { background: var(--mask); color: var(--mask-ink); border-color: var(--mask); }
      main { padding-block: 2rem 4rem; min-height: 60vh; }
      .site-footer { border-top: 1px solid var(--line); color: var(--ink-soft); font-size: 0.95rem; background: var(--surface); }
      .foot { padding-block: 2.5rem 1.5rem; display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 2rem; }
      .foot h2 { font-size: 0.95rem; color: var(--ink); margin-bottom: 0.6rem; }
      .foot ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.35rem; }
      .foot .about p { margin-top: 0.75rem; max-width: 34rem; }
      .foot a:not(.logo) { color: var(--ink-soft); }
      .foot a:not(.logo):hover { color: var(--ink); }
      .legal { padding-block: 1rem 2rem; font-size: 0.85rem; border-top: 1px solid var(--line); }
      @media (max-width: 860px) {
        .hbar { display: grid; grid-template-columns: auto 1fr; grid-template-areas: 'logo right' 'nav nav' 'search search'; gap: 0.6rem 1rem; }
        .logo { grid-area: logo; }
        nav { grid-area: nav; }
        .right { grid-area: right; justify-self: end; margin: 0 !important; }
        .header-search { grid-area: search; width: 100%; margin: 0; }
        .support span { display: none; }
        .support { padding: 0; width: 2.25rem; justify-content: center; }
        .foot { grid-template-columns: 1fr 1fr; }
        .foot .about { grid-column: 1 / -1; }
      }
    </style>
  </body>
</html>
