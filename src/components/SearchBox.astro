---
interface Props { id: string; placeholder?: string; size?: 'hero' | 'compact'; autofocus?: boolean }
const { id, placeholder = 'Search tools, cheatsheets, prompts', size = 'compact', autofocus = false } = Astro.props;
---
<div class:list={['searchbox', size]} data-searchbox>
  <label for={id} class="sr-only">Search</label>
  <input id={id} type="search" autocomplete="off" spellcheck="false" placeholder={placeholder} autofocus={autofocus} />
  <ul role="listbox" hidden></ul>
</div>

<script>
  import { bindSearch } from '../scripts/search';
  document.querySelectorAll<HTMLElement>('[data-searchbox]').forEach((box) => {
    bindSearch(box.querySelector('input')!, box.querySelector('ul')!);
  });
</script>

<style is:global>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .searchbox { position: relative; }
  .searchbox input { padding-left: 0.9rem; }
  .searchbox.hero input {
    font-size: 1.2rem; padding: 0.95rem 1.1rem; border: 2px solid var(--ink); border-radius: 10px;
    font-family: var(--font-code);
  }
  .searchbox ul {
    list-style: none; margin: 0.4rem 0 0; padding: 0.3rem; background: var(--surface);
    border: 1px solid var(--line); border-radius: var(--radius-m); max-height: 60vh; overflow-y: auto;
  }
  .searchbox.compact ul { position: absolute; left: 0; right: 0; z-index: 30; box-shadow: 0 10px 30px rgb(10 20 40 / 0.18); }
  .searchbox li a {
    display: grid; grid-template-columns: 6.5rem 1fr; column-gap: 0.75rem; padding: 0.5rem 0.6rem;
    border-radius: var(--radius-s); color: var(--ink); text-decoration: none;
  }
  .searchbox li[aria-selected='true'] a { background: var(--surface-2); }
  .r-type { color: var(--ink-soft); font-size: 0.85rem; grid-row: span 2; padding-top: 0.15rem; }
  .r-title { font-weight: 700; }
  .r-desc { color: var(--ink-soft); font-size: 0.9rem; }
  .r-empty { padding: 0.6rem; color: var(--ink-soft); }
  @media (max-width: 520px) {
    .searchbox.hero input { font-size: 1rem; }
    .searchbox li a { grid-template-columns: 1fr; }
    .r-type { grid-row: auto; }
  }
</style>
