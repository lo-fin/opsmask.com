---
import Base from '../layouts/Base.astro';
import AdSlot from './AdSlot.astro';
import { TOOLS, TOOL_GROUPS, toolBySlug } from '../data/tools';
import { TOOL_DOCS } from '../data/tool-docs';
import { SITE } from '../config';
import { getCollection } from 'astro:content';

interface Props { slug: string }
const tool = toolBySlug(Astro.props.slug);
if (!tool) throw new Error(`Unknown tool: ${Astro.props.slug}`);
const doc = TOOL_DOCS[tool.slug];
const relatedTools = (doc?.relatedTools ?? []).map(toolBySlug).filter(Boolean);
const prompts = (await getCollection('prompts')).filter(
  (p) => tool.relatedPrompts?.includes(p.id) || p.data.relatedTools.includes(tool.slug),
);
const groups = TOOL_GROUPS.map((g) => ({ name: g, tools: TOOLS.filter((t) => t.group === g) })).filter((g) => g.tools.length);
const source = `${SITE.repo}/blob/${SITE.branch}/src/pages/tools/${tool.slug}.astro`;
---
<Base title={tool.title} description={tool.description} wide>
  <details class="mobile-tool-nav">
    <summary>
      <span class="mobile-nav-label">
        <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 5h14M3 10h14M3 15h10"/></svg>
        Switch tool ({TOOLS.length})
      </span>
      <span class="badge">{tool.group}</span>
    </summary>
    <div class="mobile-nav-body">
      {groups.map((g) => (
        <div class="side-group">
          <p class="side-group-title"><span>{g.name}</span><span class="group-count">{g.tools.length}</span></p>
          <ul>
            {g.tools.map((t) => (
              <li><a href={`/tools/${t.slug}/`} aria-current={t.slug === tool.slug ? 'page' : undefined}>{t.title}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </details>

  <div class="tool-layout">
    <aside class="side-col">
      <nav class="side" aria-label="All tools">
        <div class="side-filter-wrap">
          <label for="side-filter" class="sr-only">Filter tools</label>
          <input id="side-filter" type="search" class="code side-filter" placeholder={`Filter ${TOOLS.length} tools…`} autocomplete="off" spellcheck="false" />
        </div>
        <div id="side-groups">
          {groups.map((g) => (
            <div class="side-group" data-side-group>
              <p class="side-group-title">
                <span>{g.name}</span>
                <span class="group-count">{g.tools.length}</span>
              </p>
              <ul>
                {g.tools.map((t) => (
                  <li data-tool-item data-keywords={`${t.title} ${t.group} ${t.keywords.join(' ')}`.toLowerCase()}>
                    <a href={`/tools/${t.slug}/`} aria-current={t.slug === tool.slug ? 'page' : undefined}>{t.title}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </nav>
      <div class="side-ad"><AdSlot variant="sidebar" /></div>
    </aside>

    <article class="main">
      <header class="tool-header">
        <div class="crumbs-row">
          <nav class="crumbs" aria-label="Breadcrumb">
            <a href="/tools/">Tools</a>
            <span class="sep" aria-hidden="true">/</span>
            <span class="crumb-group">{tool.group}</span>
          </nav>
          <span class="local">
            <span class="dot" aria-hidden="true"></span>
            Runs locally · Nothing leaves this tab
          </span>
        </div>
        <h1>{tool.title}</h1>
        <p class="lede">{tool.description}</p>
      </header>

      <section class="tool workbench-panel">
        <slot />
      </section>

      {prompts.length > 0 && (
        <section class="related">
          <div class="related-head">
            <span class="badge badge-mask">AI Redaction</span>
            <h2>Ask AI about the result</h2>
          </div>
          <p class="muted">These prompt templates automatically mask secrets, tokens and IPs before you copy them:</p>
          <ul>
            {prompts.map((p) => (
              <li>
                <a href={`/prompts/${p.id}/`}>
                  <span class="prompt-link-title">{p.data.title}</span>
                  <span class="prompt-link-arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <div class="notes-wrap">
        <slot name="notes" />
      </div>

      {doc && (
        <section class="tool-doc prose" aria-labelledby="tool-guide-heading">
          <h2 id="tool-guide-heading">How {tool.title} works</h2>
          <p>{doc.howItWorks}</p>

          <h3>Common DevOps &amp; engineering use cases</h3>
          <ul>
            {doc.useCases.map((u) => (
              <li>{u}</li>
            ))}
          </ul>

          <h3>Security &amp; operational notes</h3>
          <ul>
            {doc.securityNotes.map((s) => (
              <li>{s}</li>
            ))}
          </ul>

          {doc.faq.length > 0 && (
            <div class="tool-faq">
              <h3>Frequently asked questions</h3>
              {doc.faq.map((item) => (
                <details class="faq-item" open>
                  <summary>{item.question}</summary>
                  <p>{item.answer}</p>
                </details>
              ))}
            </div>
          )}

          {relatedTools.length > 0 && (
            <div class="related-tools">
              <h3>Related local tools</h3>
              <ul class="related-tools-list">
                {relatedTools.map((rt) => (
                  <li>
                    <a href={`/tools/${rt!.slug}/`}>
                      <strong>{rt!.title}</strong>
                      <span>{rt!.description}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {doc.faq.length > 0 && (
            <script
              type="application/ld+json"
              is:inline
              set:html={JSON.stringify({
                '@context': 'https://schema.org',
                '@type': 'FAQPage',
                mainEntity: doc.faq.map((item) => ({
                  '@type': 'Question',
                  name: item.question,
                  acceptedAnswer: {
                    '@type': 'Answer',
                    text: item.answer,
                  },
                })),
              })}
            />
          )}
        </section>
      )}

      <footer class="source">
        <a href={source} rel="noopener">
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.72 1.22 1.87.87 2.33.66.07-.52.28-.87.5-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.83-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
          View this tool’s source
        </a>
        <span aria-hidden="true">·</span>
        <a href={`${SITE.repo}/issues/new?template=bug_report.yml&title=${encodeURIComponent(`[${tool.title}] `)}`} rel="noopener">
          Report a problem
        </a>
      </footer>
    </article>
  </div>
</Base>

<script>
  const filterInput = document.getElementById('side-filter') as HTMLInputElement | null;
  if (filterInput) {
    filterInput.addEventListener('input', () => {
      const q = filterInput.value.trim().toLowerCase();
      document.querySelectorAll<HTMLElement>('[data-side-group]').forEach((group) => {
        let visible = 0;
        group.querySelectorAll<HTMLElement>('[data-tool-item]').forEach((item) => {
          const match = !q || (item.dataset.keywords ?? '').includes(q);
          item.hidden = !match;
          if (match) visible++;
        });
        group.hidden = visible === 0;
      });
    });
  }
</script>

<style>
  .mobile-tool-nav {
    display: none;
    margin-bottom: 1.25rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    overflow: hidden;
  }

  .mobile-tool-nav summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.7rem 1rem;
    cursor: pointer;
    font-family: var(--font-code);
    font-size: 0.88rem;
    font-weight: 600;
    list-style: none;
  }

  .mobile-tool-nav summary::-webkit-details-marker {
    display: none;
  }

  .mobile-nav-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .mobile-nav-body {
    padding: 0.75rem 1rem 1rem;
    border-top: 1px solid var(--line);
    max-height: 55vh;
    overflow-y: auto;
  }

  .tool-layout {
    display: grid;
    grid-template-columns: 16.5rem minmax(0, 1fr);
    column-gap: 2.5rem;
    align-items: start;
  }

  .side-col {
    display: grid;
    gap: 1.5rem;
    position: sticky;
    top: calc(var(--header-height) + 1rem);
    max-height: calc(100vh - var(--header-height) - 2rem);
    overflow-y: auto;
    padding-right: 0.25rem;
  }

  .side {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    padding: 0.9rem;
    font-size: 0.88rem;
    box-shadow: var(--shadow-sm);
  }

  .side-filter-wrap {
    margin-bottom: 0.85rem;
  }

  .side-filter {
    padding: 0.42rem 0.65rem;
    font-size: 0.8rem;
    border-radius: var(--radius-s);
  }

  .side-group {
    margin-bottom: 0.95rem;
  }

  .side-group:last-child {
    margin-bottom: 0;
  }

  .side-group-title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 0 0 0.35rem;
    padding-inline: 0.45rem;
    color: var(--ink-muted);
    font-family: var(--font-code);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .group-count {
    font-size: 0.68rem;
    background: var(--bg-subtle);
    padding: 0.05rem 0.38rem;
    border-radius: 999px;
    border: 1px solid var(--line);
  }

  .side ul,
  .mobile-nav-body ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.12rem;
  }

  .side a,
  .mobile-nav-body a {
    display: block;
    padding: 0.36rem 0.55rem;
    border-left: 3px solid transparent;
    color: var(--ink-soft);
    text-decoration: none;
    border-radius: 0 var(--radius-s) var(--radius-s) 0;
    line-height: 1.35;
    transition: background-color 140ms ease, color 140ms ease, border-color 140ms ease;
  }

  .side a:hover,
  .mobile-nav-body a:hover {
    background: var(--surface-2);
    color: var(--ink);
  }

  .side a[aria-current='page'],
  .mobile-nav-body a[aria-current='page'] {
    border-left-color: var(--mask);
    background: var(--surface-2);
    color: var(--ink);
    font-weight: 700;
  }

  .main {
    min-width: 0;
    max-width: 62rem;
  }

  .tool-header {
    margin-bottom: 1.5rem;
  }

  .crumbs-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-bottom: 0.65rem;
  }

  .crumbs {
    color: var(--ink-soft);
    font-family: var(--font-code);
    font-size: 0.84rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .crumbs a {
    color: var(--ink-soft);
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .crumb-group {
    color: var(--ink);
    font-weight: 600;
  }

  .sep {
    color: var(--ink-muted);
  }

  .local {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-code);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--ok);
    background: var(--accent-soft);
    border: 1px solid color-mix(in srgb, var(--ok) 30%, transparent);
    padding: 0.22rem 0.65rem;
    border-radius: 999px;
  }

  .dot {
    width: 0.48rem;
    height: 0.48rem;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--ok) 25%, transparent);
  }

  .lede {
    font-size: 1.08rem;
    color: var(--ink-soft);
    margin-bottom: 0;
  }

  .workbench-panel {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    padding: 1.35rem 1.45rem;
    box-shadow: var(--shadow-md);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    min-width: 0;
  }

  .related {
    margin-top: 2.25rem;
    padding: 1.15rem 1.35rem;
    border: 1px solid color-mix(in srgb, var(--mask) 40%, var(--line));
    border-left: 4px solid var(--mask);
    background: var(--surface);
    border-radius: var(--radius-m);
    box-shadow: var(--shadow-sm);
  }

  .related-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.35rem;
  }

  .related h2 {
    font-size: 1.05rem;
    margin: 0;
  }

  .related p {
    margin-bottom: 0.65rem;
    font-size: 0.92rem;
  }

  .related ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .related li a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.38rem 0.75rem;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: var(--radius-s);
    color: var(--ink);
    font-family: var(--font-code);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
  }

  .related li a:hover {
    border-color: var(--mask);
    background: var(--surface-hover);
  }

  .prompt-link-arrow {
    color: var(--mask);
  }

  .notes-wrap {
    margin-top: 2.25rem;
  }

  .tool-doc {
    margin-top: 2rem;
    padding: 1.5rem 1.75rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-sm);
  }

  .tool-doc > h2:first-child {
    margin-top: 0;
  }

  .tool-faq {
    margin-top: 1.5rem;
  }

  .faq-item {
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    background: var(--bg-subtle);
    padding: 0.75rem 1rem;
    margin-bottom: 0.65rem;
  }

  .faq-item summary {
    cursor: pointer;
    font-weight: 700;
    color: var(--ink);
  }

  .faq-item p {
    margin: 0.55rem 0 0;
    color: var(--ink-soft);
    font-size: 0.94rem;
  }

  .related-tools {
    margin-top: 1.5rem;
  }

  .related-tools-list {
    list-style: none;
    padding: 0;
    margin: 0.65rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 0.75rem;
  }

  .related-tools-list li {
    margin: 0;
  }

  .related-tools-list a {
    display: block;
    height: 100%;
    padding: 0.8rem 0.95rem;
    background: var(--bg-subtle);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    text-decoration: none;
    transition: border-color 150ms ease, background-color 150ms ease;
  }

  .related-tools-list a:hover {
    border-color: var(--accent);
    background: var(--surface-2);
    text-decoration: none;
  }

  .related-tools-list strong {
    display: block;
    color: var(--ink);
    font-size: 0.9rem;
    margin-bottom: 0.2rem;
  }

  .related-tools-list span {
    display: block;
    color: var(--ink-soft);
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .source {
    margin-top: 2.5rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
    font-family: var(--font-code);
    font-size: 0.82rem;
    color: var(--ink-soft);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  .source a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--ink-soft);
    text-decoration: none;
  }

  .source a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  @media (max-width: 1024px) {
    .mobile-tool-nav {
      display: block;
    }
    .tool-layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .side-col {
      position: static;
      max-height: none;
      order: 2;
      margin-top: 2rem;
    }
    .side {
      display: none;
    }
    .workbench-panel {
      padding: 1.1rem;
    }
  }
</style>
