---
import Base from '../layouts/Base.astro';
import { SITE } from '../config';
---
<Base title="Page Not Found" description="The page you were looking for could not be found.">
  <div class="prose" style="text-align: center; padding: 3rem 1rem;">
    <h1 style="font-size: 3.5rem; margin-bottom: 0.5rem;">404</h1>
    <p style="font-size: 1.25rem; color: var(--ink-soft); margin-bottom: 1.5rem;">Page Not Found</p>
    <p>The page you are looking for does not exist or has been moved.</p>
    <p style="margin-top: 2rem;">
      <a class="btn" href="/">Back to Home</a>
    </p>
  </div>
</Base>
