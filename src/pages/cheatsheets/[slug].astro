---
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getCollection, render } from 'astro:content';
import { repoEditUrl } from '../../config';

export async function getStaticPaths() {
  const items = await getCollection('cheatsheets');
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
---
<Base title={entry.data.title} description={entry.data.description} wide>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/cheatsheets/">Cheatsheets</a>
    <span aria-hidden="true">/</span>
    <span>{entry.data.title}</span>
  </nav>
  <div class="layout">
    <article class="prose sheet-card">
      <header class="sheet-head">
        <div class="tags">
          {entry.data.tags.map((t) => <span class="badge">{t}</span>)}
        </div>
        <h1>{entry.data.title}</h1>
        <p class="lede">{entry.data.description}</p>
      </header>
      <Content />
      <p class="edit"><a href={repoEditUrl(entry.filePath)} rel="noopener">Edit this cheatsheet on GitHub</a></p>
    </article>
    <div class="aside">
      {toc.length > 2 && (
        <nav class="toc" aria-label="On this page">
          <p>On this page</p>
          <ul>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
        </nav>
      )}
      <AdSlot variant="sidebar" />
    </div>
  </div>
</Base>

<style>
  .crumbs {
    font-family: var(--font-code);
    font-size: 0.85rem;
    color: var(--ink-soft);
    margin-bottom: 1rem;
    display: inline-flex;
    gap: 0.45rem;
  }
  .crumbs a {
    color: var(--ink-soft);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--accent);
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 17.5rem;
    gap: 2.5rem;
    align-items: start;
  }
  .sheet-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    padding: 1.75rem 2rem;
    box-shadow: var(--shadow-md);
    max-width: 100%;
  }
  .sheet-head {
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 1.5rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
  }
  .lede {
    font-size: 1.08rem;
    color: var(--ink-soft);
    margin: 0;
  }
  .aside {
    position: sticky;
    top: calc(var(--header-height) + 1rem);
    display: grid;
    gap: 1.5rem;
  }
  .toc {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    padding: 1rem 1.15rem;
    font-size: 0.88rem;
    box-shadow: var(--shadow-sm);
  }
  .toc p {
    font-family: var(--font-code);
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 700;
    color: var(--ink-muted);
    margin: 0 0 0.6rem;
  }
  .toc ul {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 2px solid var(--line);
    display: grid;
    gap: 0.15rem;
  }
  .toc li a {
    display: block;
    padding: 0.25rem 0.75rem;
    color: var(--ink-soft);
    text-decoration: none;
    border-radius: 0 var(--radius-s) var(--radius-s) 0;
  }
  .toc li a:hover {
    color: var(--ink);
    background: var(--surface-2);
  }
  .edit {
    margin-top: 2.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-family: var(--font-code);
    font-size: 0.84rem;
  }
  .edit a {
    color: var(--ink-soft);
  }
  @media (max-width: 960px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .toc {
      display: none;
    }
    .aside {
      position: static;
    }
    .sheet-card {
      padding: 1.25rem;
    }
  }
</style>
