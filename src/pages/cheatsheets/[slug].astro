---
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getCollection, render } from 'astro:content';
import { repoEditUrl } from '../../config';

export async function getStaticPaths() {
  const items = await getCollection('cheatsheets');
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
---
<Base title={entry.data.title} description={entry.data.description}>
  <nav class="crumbs" aria-label="Breadcrumb"><a href="/cheatsheets/">Cheatsheets</a></nav>
  <div class="layout">
    <article class="prose">
      <h1>{entry.data.title}</h1>
      <p class="lede">{entry.data.description}</p>
      <Content />
      <p class="edit"><a href={repoEditUrl(entry.filePath)} rel="noopener">Edit this cheatsheet on GitHub</a></p>
    </article>
    <div class="aside">
      {toc.length > 2 && (
        <nav class="toc" aria-label="On this page">
          <p>On this page</p>
          <ul>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
        </nav>
      )}
      <AdSlot variant="sidebar" />
    </div>
  </div>
</Base>
<style>
  .crumbs { font-size: 0.95rem; margin-bottom: 0.75rem; }
  .crumbs a { color: var(--ink-soft); }
  .lede { font-size: 1.15rem; color: var(--ink-soft); }
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 16rem; gap: 3rem; align-items: start; }
  .aside { position: sticky; top: 5rem; display: grid; gap: 1.5rem; }
  .toc { font-size: 0.93rem; }
  .edit { margin-top: 2.5rem; font-size: 0.9rem; }
  .edit a { color: var(--ink-soft); }
  .toc p { font-weight: 700; margin-bottom: 0.4rem; }
  .toc ul { list-style: none; padding: 0; margin: 0; border-left: 2px solid var(--line); }
  .toc li a { display: block; padding: 0.2rem 0.75rem; color: var(--ink-soft); text-decoration: none; }
  .toc li a:hover { color: var(--ink); }
  @media (max-width: 900px) { .layout { grid-template-columns: 1fr; } .toc { display: none; } .aside { position: static; } }
</style>
