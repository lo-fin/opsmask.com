---
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getCollection, render } from 'astro:content';
import { toolBySlug } from '../../data/tools';
import { SITE, repoEditUrl } from '../../config';

export async function getStaticPaths() {
  const items = await getCollection('guides');
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
const relatedTools = entry.data.relatedTools.map(toolBySlug).filter(Boolean);
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
---
<Base title={entry.data.title} description={entry.data.description} wide>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/guides/">Guides</a>
    <span aria-hidden="true">/</span>
    <span>{entry.data.category}</span>
  </nav>

  <div class="layout">
    <article class="prose guide-card">
      <header class="guide-head">
        <div class="meta-row">
          <span class="badge badge-accent">{entry.data.category}</span>
          <span class="meta-info">Published {entry.data.published}{entry.data.updated ? ` · Updated ${entry.data.updated}` : ''} · {entry.data.readingTime}</span>
        </div>
        <h1>{entry.data.title}</h1>
        <p class="lede">{entry.data.description}</p>
        <div class="tags">
          {entry.data.tags.map((t) => <span class="badge">#{t}</span>)}
        </div>
      </header>

      <Content />

      {relatedTools.length > 0 && (
        <section class="related-tools">
          <h2>Tools referenced in this guide</h2>
          <p class="muted">Every tool below executes 100% locally in your browser—no pasted configs or secrets leave your tab.</p>
          <ul class="tool-links">
            {relatedTools.map((t) => (
              <li>
                <a href={`/tools/${t!.slug}/`}>
                  <strong>{t!.title}</strong>
                  <span>{t!.description}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <p class="edit"><a href={repoEditUrl(entry.filePath)} rel="noopener">Suggest an edit to this guide on GitHub</a></p>
    </article>

    <aside class="aside">
      {toc.length > 1 && (
        <nav class="toc" aria-label="On this page">
          <p>On this page</p>
          <ul>
            {toc.map((h) => (
              <li><a href={`#${h.slug}`}>{h.text}</a></li>
            ))}
          </ul>
        </nav>
      )}
      <AdSlot variant="sidebar" />
    </aside>
  </div>

  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'TechArticle',
      headline: entry.data.title,
      description: entry.data.description,
      datePublished: entry.data.published,
      dateModified: entry.data.updated ?? entry.data.published,
      mainEntityOfPage: canonical,
      author: {
        '@type': 'Organization',
        name: SITE.name,
        url: SITE.url,
      },
      publisher: {
        '@type': 'Organization',
        name: SITE.name,
        url: SITE.url,
      },
    })}
  />
</Base>

<style>
  .crumbs {
    font-family: var(--font-code);
    font-size: 0.85rem;
    color: var(--ink-soft);
    margin-bottom: 1rem;
    display: inline-flex;
    gap: 0.45rem;
  }
  .crumbs a {
    color: var(--ink-soft);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--accent);
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 17.5rem;
    gap: 2.5rem;
    align-items: start;
  }
  .guide-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    padding: 2rem 2.25rem;
    box-shadow: var(--shadow-md);
    max-width: 100%;
  }
  .guide-head {
    padding-bottom: 1.35rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 1.75rem;
  }
  .meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.65rem;
  }
  .meta-info {
    font-family: var(--font-code);
    font-size: 0.8rem;
    color: var(--ink-muted);
  }
  .guide-head h1 {
    margin: 0.35rem 0 0.65rem;
  }
  .lede {
    font-size: 1.08rem;
    color: var(--ink-soft);
    margin-bottom: 1rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .related-tools {
    margin-top: 2.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .tool-links {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 0.75rem;
  }
  .tool-links li {
    margin: 0;
  }
  .tool-links a {
    display: block;
    height: 100%;
    padding: 0.85rem 1rem;
    background: var(--bg-subtle);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    text-decoration: none;
  }
  .tool-links a:hover {
    border-color: var(--accent);
    background: var(--surface-2);
    text-decoration: none;
  }
  .tool-links strong {
    display: block;
    color: var(--ink);
    font-size: 0.92rem;
    margin-bottom: 0.2rem;
  }
  .tool-links span {
    display: block;
    color: var(--ink-soft);
    font-size: 0.82rem;
    line-height: 1.45;
  }
  .edit {
    margin-top: 2rem;
    font-family: var(--font-code);
    font-size: 0.84rem;
  }
  .aside {
    position: sticky;
    top: calc(var(--header-height) + 1rem);
    display: grid;
    gap: 1.25rem;
  }
  .toc {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    padding: 1rem 1.15rem;
    font-size: 0.86rem;
  }
  .toc p {
    margin: 0 0 0.6rem;
    font-family: var(--font-code);
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
  }
  .toc ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.35rem;
  }
  .toc a {
    color: var(--ink-soft);
    text-decoration: none;
    line-height: 1.35;
  }
  .toc a:hover {
    color: var(--accent);
  }
  @media (max-width: 1024px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .aside {
      position: static;
    }
    .guide-card {
      padding: 1.4rem;
    }
  }
</style>
