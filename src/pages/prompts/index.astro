---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const items = await getCollection('prompts');
const categories = [...new Set(items.map((p) => p.data.category))].sort();
---
<Base title="AI prompts for DevOps" description="Fill-in-the-blank AI prompts for reviewing manifests, writing queries and debugging incidents, with automatic secret masking." wide>
  <header class="page-head">
    <span class="badge badge-mask">Secret-Masking Prompt Workbench</span>
    <h1>AI Prompts for DevOps</h1>
    <p class="muted">Fill in the blanks, inspect the live redacted preview, then copy into ChatGPT, Claude or Copilot without exposing production secrets.</p>
  </header>

  {categories.map((cat) => (
    <section class="cat">
      <div class="cat-head">
        <h2>{cat}</h2>
        <span class="badge">{items.filter((p) => p.data.category === cat).length} prompts</span>
      </div>
      <ul class="cards">
        {items.filter((p) => p.data.category === cat).map((p) => (
          <li class="card">
            <a href={`/prompts/${p.id}/`}>
              <div class="card-top">
                <span class="badge badge-mask">{p.data.category}</span>
                <span class="var-count">{p.data.variables.length} fields</span>
              </div>
              <h3>{p.data.title}</h3>
              <p>{p.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>

<style>
  .page-head {
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--line);
  }
  .page-head h1 {
    margin: 0.45rem 0 0.35rem;
  }
  .page-head p {
    margin: 0;
  }
  .cat {
    margin-top: 2.5rem;
  }
  .cat-head {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1rem;
  }
  .cat-head h2 {
    margin: 0;
  }
  .cards {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(21rem, 1fr));
    gap: 1rem;
  }
  .card a {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.2rem 1.3rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    color: var(--ink);
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition: transform 150ms ease, border-color 150ms ease, background-color 150ms ease, box-shadow 150ms ease;
  }
  .card a:hover {
    transform: translateY(-2px);
    border-color: var(--mask);
    background: var(--surface-2);
    box-shadow: var(--shadow-md);
  }
  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.65rem;
  }
  .var-count {
    font-family: var(--font-code);
    font-size: 0.76rem;
    color: var(--ink-muted);
  }
  .card h3 {
    font-size: 1rem;
    margin: 0 0 0.4rem;
  }
  .card p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.9rem;
  }
</style>
