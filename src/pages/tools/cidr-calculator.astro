---
import ToolShell from '../../components/ToolShell.astro';
---
<ToolShell slug="cidr-calculator">
  <div class="inputs">
    <div>
      <label for="cidr">IPv4 CIDR</label>
      <input id="cidr" type="text" class="code" value="10.20.0.0/16" spellcheck="false" />
    </div>
    <div>
      <label for="split">Split into</label>
      <select id="split"></select>
    </div>
  </div>
  <p id="cidr-err" class="status-err" aria-live="polite"></p>
  <div class="table-wrap"><table id="cidr-info"></table></div>
  <section>
    <h2 id="split-title">Subnets</h2>
    <div class="table-wrap"><table id="cidr-split"></table></div>
    <p id="split-more" class="muted"></p>
  </section>

  <div slot="notes" class="prose">
    <h2>Why “usable in Azure” is smaller</h2>
    <p>Azure reserves five addresses in every subnet: the network address, the first three host addresses (gateway and DNS) and the broadcast address. A /29 gives you 3 usable IPs in Azure, not 6. AWS also reserves five per subnet.</p>
  </div>
</ToolShell>

<script>
  const input = document.getElementById('cidr') as HTMLInputElement;
  const split = document.getElementById('split') as HTMLSelectElement;
  const err = document.getElementById('cidr-err')!;
  const info = document.getElementById('cidr-info')!;
  const splitTable = document.getElementById('cidr-split')!;
  const splitTitle = document.getElementById('split-title')!;
  const more = document.getElementById('split-more')!;
  const MAX_ROWS = 256;

  const toInt = (ip: string) => ip.split('.').reduce((a, o) => (a << 8) + Number(o), 0) >>> 0;
  const toIp = (n: number) => [24, 16, 8, 0].map((s) => (n >>> s) & 255).join('.');
  const maskOf = (p: number) => (p === 0 ? 0 : (0xffffffff << (32 - p)) >>> 0);
  const fmt = (n: number) => n.toLocaleString('en');

  function parse(v: string) {
    const m = v.trim().match(/^(\d{1,3}(?:\.\d{1,3}){3})(?:\/(\d{1,2}))?$/);
    if (!m) return null;
    const octets = m[1].split('.').map(Number);
    const prefix = m[2] === undefined ? 32 : Number(m[2]);
    if (octets.some((o) => o > 255) || prefix > 32) return null;
    return { ip: toInt(m[1]), prefix };
  }

  function rangeOf(net: number, p: number) {
    const size = 2 ** (32 - p);
    const network = (net & maskOf(p)) >>> 0;
    const broadcast = (network + size - 1) >>> 0;
    const usable = p >= 31 ? size : size - 2;
    const first = p >= 31 ? network : network + 1;
    const last = p >= 31 ? broadcast : broadcast - 1;
    return { network, broadcast, size, usable, first, last, azure: Math.max(size - 5, 0) };
  }

  let lastPrefix = -1;
  function fillSplit(prefix: number) {
    if (prefix === lastPrefix) return;
    lastPrefix = prefix;
    const prev = Number(split.value) || Math.min(prefix + 8, 32);
    split.innerHTML = '';
    for (let p = prefix + 1; p <= 32; p++) {
      const o = document.createElement('option');
      o.value = String(p);
      o.textContent = `/${p}  (${fmt(2 ** (p - prefix))} subnets)`;
      split.appendChild(o);
    }
    split.value = String(Math.min(Math.max(prev, prefix + 1), 32));
  }

  function run() {
    err.textContent = '';
    const parsed = parse(input.value);
    if (!parsed) {
      err.textContent = 'Enter an IPv4 range like 10.0.0.0/16.';
      info.innerHTML = splitTable.innerHTML = more.textContent = '';
      return;
    }
    const { ip, prefix } = parsed;
    const r = rangeOf(ip, prefix);
    const mask = maskOf(prefix);
    const rows: [string, string][] = [
      ['Network', `${toIp(r.network)}/${prefix}`],
      ['Netmask', toIp(mask)],
      ['Wildcard', toIp(~mask >>> 0)],
      ['Host range', `${toIp(r.first)} – ${toIp(r.last)}`],
      ['Broadcast', toIp(r.broadcast)],
      ['Total addresses', fmt(r.size)],
      ['Usable hosts', fmt(r.usable)],
      ['Usable in Azure / AWS', fmt(r.azure)],
    ];
    if (r.network !== ip) rows.unshift(['Note', `${toIp(ip)} is not the network address. Using ${toIp(r.network)}/${prefix}.`]);
    info.innerHTML = `<tbody>${rows.map(([k, v]) => `<tr><th>${k}</th><td><code>${v}</code></td></tr>`).join('')}</tbody>`;

    if (prefix >= 32) { splitTable.innerHTML = ''; splitTitle.hidden = true; split.disabled = true; more.textContent = ''; return; }
    splitTitle.hidden = false; split.disabled = false;
    fillSplit(prefix);
    const sp = Number(split.value);
    const count = 2 ** (sp - prefix);
    const step = 2 ** (32 - sp);
    const shown = Math.min(count, MAX_ROWS);
    const body: string[] = [];
    for (let i = 0; i < shown; i++) {
      const s = rangeOf((r.network + i * step) >>> 0, sp);
      body.push(`<tr><td><code>${toIp(s.network)}/${sp}</code></td><td>${toIp(s.first)} – ${toIp(s.last)}</td><td>${fmt(s.usable)}</td><td>${fmt(s.azure)}</td></tr>`);
    }
    splitTable.innerHTML = `<thead><tr><th>Subnet</th><th>Hosts</th><th>Usable</th><th>Azure</th></tr></thead><tbody>${body.join('')}</tbody>`;
    more.textContent = count > shown ? `Showing the first ${shown} of ${fmt(count)} subnets.` : '';
  }

  input.addEventListener('input', run);
  split.addEventListener('change', run);
  run();
</script>

<style>
  .inputs { display: grid; grid-template-columns: minmax(0, 1fr) 16rem; gap: 1rem; max-width: 40rem; }
  #cidr-err { margin: 0; }
  @media (max-width: 600px) { .inputs { grid-template-columns: 1fr; } }
</style>
