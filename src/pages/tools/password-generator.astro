---
import ToolShell from '../../components/ToolShell.astro';
---
<ToolShell slug="password-generator">
  <div class="block">
    <div class="controls">
      <label class="inline-sel" for="sec-mode">
        Type
        <select id="sec-mode">
          <option value="password" selected>Random password</option>
          <option value="hex">Hex key (openssl rand -hex)</option>
          <option value="base64url">Base64url key (JWT / OAuth)</option>
          <option value="base64">Base64 key (openssl rand -base64)</option>
          <option value="api-key">Prefixed API token (sk_, whsec_)</option>
          <option value="passphrase">Memorable passphrase (word-word-99)</option>
        </select>
      </label>

      <label class="inline-sel" id="len-wrap" for="pwd-len">
        <span id="len-label">Length</span>
        <input id="pwd-len" type="number" min="4" max="128" value="24" class="code num-in" />
      </label>

      <label class="inline-sel" id="prefix-wrap" for="api-prefix" hidden>
        Prefix
        <input id="api-prefix" type="text" value="sk_live_" class="code prefix-in" />
      </label>

      <label class="inline-sel" id="words-wrap" for="word-count" hidden>
        Words
        <select id="word-count">
          <option value="3">3 words</option>
          <option value="4" selected>4 words</option>
          <option value="5">5 words</option>
          <option value="6">6 words</option>
        </select>
      </label>

      <label class="inline-sel" for="pwd-count">
        Count
        <select id="pwd-count">
          <option value="1">1</option>
          <option value="5" selected>5</option>
          <option value="10">10</option>
          <option value="20">20</option>
        </select>
      </label>
    </div>

    <div class="controls" id="char-opts">
      <label class="check"><input type="checkbox" id="opt-upper" checked /> A–Z</label>
      <label class="check"><input type="checkbox" id="opt-lower" checked /> a–z</label>
      <label class="check"><input type="checkbox" id="opt-digits" checked /> 0–9</label>
      <label class="check"><input type="checkbox" id="opt-symbols" checked /> Symbols</label>
      <label class="check"><input type="checkbox" id="opt-safe" /> URL / conn-string safe symbols (<code>-_.~</code>)</label>
      <label class="check"><input type="checkbox" id="opt-ambig" checked /> Avoid ambiguous (<code>0O1lI</code>)</label>
    </div>

    <div class="toolbar">
      <div class="toolbar-left">
        <button class="btn small-btn" type="button" id="regen-btn">Regenerate</button>
        <span id="entropy-label" class="muted small" aria-live="polite"></span>
      </div>
      <button class="btn ghost small-btn" type="button" id="copy-all">Copy all</button>
    </div>

    <p id="pwd-err" class="status-err" aria-live="polite"></p>

    <table id="pwd-table" class="fixed-table">
      <thead>
        <tr>
          <th class="idx-col">#</th>
          <th class="val-col">Generated value</th>
          <th class="act-col"><span class="sr-only">Copy</span></th>
        </tr>
      </thead>
      <tbody id="pwd-body"></tbody>
    </table>
  </div>

  <div slot="notes" class="prose">
    <h2>Choosing the right secret format</h2>
    <p>Use <strong>Hex key</strong> (32 bytes = 256 bits) or <strong>Base64url key</strong> for HMAC signing secrets (<code>JWT_SECRET</code>, <code>NEXTAUTH_SECRET</code>, AES-256 keys). For database passwords embedded in connection strings or URLs, use <strong>Random password</strong> with <strong>URL / conn-string safe symbols</strong> enabled so characters like <code>;</code>, <code>@</code>, <code>/</code> or <code>?</code> never break parsing.</p>
  </div>
</ToolShell>

<script>
  import { copyText } from '../../scripts/copy';
  import { calculateEntropyBits, generatePasswords, type PasswordOptions, type SecretMode } from '../../lib/generators';

  const $ = <T extends HTMLElement = HTMLInputElement>(id: string) => document.getElementById(id) as T;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  const modeEl = $<HTMLSelectElement>('sec-mode');
  const lenIn = $('pwd-len');
  const lenLabel = $('len-label');
  const lenWrap = $('len-wrap');
  const prefixWrap = $('prefix-wrap');
  const wordsWrap = $('words-wrap');
  const charOpts = $('char-opts');
  const tbodyEl = $('pwd-body');
  const errEl = $('pwd-err');
  const entropyEl = $('entropy-label');
  const tableEl = $('pwd-table');

  let list: string[] = [];
  let lastMode: SecretMode = 'password';

  function syncModeUI() {
    const mode = modeEl.value as SecretMode;
    if (mode !== lastMode) {
      if (mode === 'hex' || mode === 'base64' || mode === 'base64url') {
        lenIn.value = '32';
      } else if (mode === 'api-key') {
        lenIn.value = '32';
      } else if (mode === 'password') {
        lenIn.value = '24';
      }
      lastMode = mode;
    }
    const isByteMode = mode === 'hex' || mode === 'base64' || mode === 'base64url';
    lenLabel.textContent = isByteMode ? 'Bytes' : 'Length';
    lenWrap.hidden = mode === 'passphrase';
    prefixWrap.hidden = mode !== 'api-key';
    wordsWrap.hidden = mode !== 'passphrase';
    charOpts.hidden = mode !== 'password';
  }

  function getOpts(): PasswordOptions {
    return {
      mode: modeEl.value as SecretMode,
      length: Number(lenIn.value) || 24,
      count: Number($<HTMLSelectElement>('pwd-count').value) || 5,
      uppercase: $('opt-upper').checked,
      lowercase: $('opt-lower').checked,
      digits: $('opt-digits').checked,
      symbols: $('opt-symbols').checked,
      safeSymbolsOnly: $('opt-safe').checked,
      excludeAmbiguous: $('opt-ambig').checked,
      prefix: $('api-prefix').value,
      wordCount: Number($<HTMLSelectElement>('word-count').value) || 4,
    };
  }

  function run() {
    syncModeUI();
    errEl.textContent = '';
    const opts = getOpts();
    try {
      list = generatePasswords(opts);
      const bits = calculateEntropyBits(opts);
      const strength = bits >= 100 ? 'Strong' : bits >= 64 ? 'Good' : 'Weak';
      entropyEl.textContent = `~${bits} bits entropy (${strength})`;
      tableEl.hidden = false;
      tbodyEl.innerHTML = list
        .map(
          (pwd, idx) => `<tr>
            <td class="idx-cell muted">${idx + 1}</td>
            <td class="val-cell"><span class="val" id="val-${idx}" title="${esc(pwd)}">${esc(pwd)}</span></td>
            <td class="act-col">
              <button class="btn ghost copy-val-btn" type="button" data-copy-val="${idx}">Copy</button>
            </td>
          </tr>`,
        )
        .join('');
    } catch (e) {
      list = [];
      tableEl.hidden = true;
      entropyEl.textContent = '';
      errEl.textContent = (e as Error).message;
    }
  }

  tbodyEl.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-copy-val]');
    if (!btn) return;
    const idx = Number(btn.dataset.copyVal);
    if (list[idx]) copyText(btn, list[idx], document.getElementById(`val-${idx}`));
  });

  $('copy-all').addEventListener('click', (e) => {
    copyText(e.currentTarget as HTMLButtonElement, list.join('\n'));
  });

  $('regen-btn').addEventListener('click', run);
  document.querySelectorAll('input, select').forEach((el) => {
    el.addEventListener('input', run);
    el.addEventListener('change', run);
  });

  run();
</script>

<style>
  .block { display: grid; gap: 0.85rem; }
  .controls { display: flex; flex-wrap: wrap; gap: 0.65rem 1.15rem; align-items: center; }
  .controls[hidden] { display: none; }
  .inline-sel { display: inline-flex; align-items: center; gap: 0.45rem; margin: 0; font-weight: 400; }
  .inline-sel[hidden] { display: none; }
  .inline-sel select { width: auto; padding: 0.3rem 0.6rem; }
  .num-in {
    width: 4.8rem;
    padding: 0.3rem 0.5rem;
    background: var(--surface);
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
  }
  .prefix-in {
    width: 7.5rem;
    padding: 0.3rem 0.5rem;
  }
  .toolbar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0.75rem; }
  .toolbar-left { display: flex; align-items: center; gap: 0.85rem; }
  .small-btn { padding: 0.35rem 0.8rem; font-size: 0.9rem; }
  .small { font-size: 0.85rem; }
  .status-err:empty { display: none; }

  .fixed-table {
    table-layout: fixed;
    width: 100%;
    border-collapse: collapse;
  }
  .fixed-table[hidden] { display: none; }
  .fixed-table th,
  .fixed-table td {
    vertical-align: middle;
  }
  .idx-col,
  .idx-cell {
    width: 2.5rem;
    white-space: nowrap;
  }
  .val-col,
  .val-cell {
    width: auto;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .val {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-code);
    font-size: 0.9rem;
  }
  .act-col {
    width: 6.25rem;
    text-align: right;
    white-space: nowrap;
  }
  .copy-val-btn {
    padding: 0.3rem 0.7rem;
    font-size: 0.9rem;
  }
</style>
