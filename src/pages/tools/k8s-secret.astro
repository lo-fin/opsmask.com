---
import ToolShell from '../../components/ToolShell.astro';
const sample = `apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  namespace: prod
type: Opaque
data:
  DB_HOST: cG9zdGdyZXMucHJvZC5zdmM=
  DB_PASSWORD: czNjcjN0LXBhc3N3b3JkCg==
  Blob__AccessTier: Q29vbA==
  Blob__AccountUrl: aHR0cHM6Ly9zdGJyYW5kc2FuZGJveDAwMDIuYmxvYi5jb3JlLndpbmRvd3MubmV0
  config.json: eyJyZXRyaWVzIjogMywgInRpbWVvdXQiOiAiMzBzIn0=
`;
const snippetSample = `  Blob__AccessTier: Q29vbA==
  Blob__AccountUrl: aHR0cHM6Ly9zdGJyYW5kc2FuZGJveDAwMDIuYmxvYi5jb3JlLndpbmRvd3MubmV0`;
---
<ToolShell slug="k8s-secret">
  <div class="controls" role="radiogroup" aria-label="Mode">
    <label class="check"><input type="radio" name="mode" value="decode" checked /> Decode a Secret</label>
    <label class="check"><input type="radio" name="mode" value="encode" /> Create a Secret</label>
  </div>

  <section id="decode" class="block">
    <div class="row">
      <label for="dec-in">Secret YAML / JSON, <code>data:</code> block, or bare <code>KEY: Base64</code> lines</label>
      <div class="row-btns">
        <button class="btn ghost" type="button" id="load-snippet">Load KEY: Base64 snippet</button>
        <button class="btn ghost" type="button" id="load-sample">Load full Secret</button>
      </div>
    </div>
    <textarea
      id="dec-in"
      class="code"
      spellcheck="false"
      placeholder="Paste a Kubernetes Secret manifest, `kubectl get secret -o yaml` output, or bare lines like:&#10;  Blob__AccessTier: Q29vbA==&#10;  Blob__AccountUrl: aHR0cHM6Ly9zdGJyYW5kc2FuZGJveDAwMDIuYmxvYi5jb3JlLndpbmRvd3MubmV0"
    ></textarea>
    <label class="check"><input type="checkbox" id="reveal" /> Show values</label>
    <p id="dec-err" class="status-err" aria-live="polite"></p>
    <div class="table-wrap"><table id="dec-out"></table></div>
    <div id="dec-yaml-wrap" hidden>
      <div class="row">
        <div class="fmt-row">
          <label for="dec-fmt">Decoded output</label>
          <select id="dec-fmt" class="fmt-select">
            <option value="yaml-kv">YAML (KEY: value)</option>
            <option value="dotenv">.env (KEY=VALUE)</option>
            <option value="json-nested">Nested JSON (appsettings.json from __)</option>
            <option value="stringdata">Secret YAML with stringData</option>
          </select>
        </div>
        <button class="btn ghost" type="button" data-copy="dec-yaml">Copy</button>
      </div>
      <textarea id="dec-yaml" class="code" readonly aria-label="Decoded output"></textarea>
    </div>
  </section>

  <section id="encode" class="block" hidden>
    <div class="grid">
      <div><label for="enc-name">Name</label><input id="enc-name" type="text" class="code" value="app-secrets" /></div>
      <div><label for="enc-ns">Namespace</label><input id="enc-ns" type="text" class="code" value="" placeholder="optional" /></div>
      <div><label for="enc-type">Type</label>
        <select id="enc-type">
          <option value="Opaque">Opaque</option>
          <option value="kubernetes.io/dockerconfigjson">kubernetes.io/dockerconfigjson</option>
          <option value="kubernetes.io/basic-auth">kubernetes.io/basic-auth</option>
        </select>
      </div>
    </div>
    <div id="enc-kv-wrap">
      <div class="row">
        <label for="enc-kv">Values: .env, JSON or YAML</label>
        <span id="enc-format" class="muted small" aria-live="polite"></span>
      </div>
      <textarea id="enc-kv" class="code" spellcheck="false" placeholder="DB_USER=app&#10;DB_PASSWORD=&quot;s3cr3t with spaces&quot;&#10;&#10;or {&quot;DB_USER&quot;: &quot;app&quot;}  or  DB_USER: app"></textarea>
    </div>
    <div id="enc-reg-wrap" class="grid" hidden>
      <div><label for="reg-server">Registry</label><input id="reg-server" type="text" class="code" value="myregistry.azurecr.io" /></div>
      <div><label for="reg-user">Username</label><input id="reg-user" type="text" class="code" /></div>
      <div><label for="reg-pass">Password or token</label><input id="reg-pass" type="text" class="code" autocomplete="off" /></div>
    </div>
    <div id="enc-nested-wrap" class="nested" hidden>
      <label for="enc-nested">Nested values</label>
      <select id="enc-nested">
        <option value="env">Flatten with __ (.NET, env vars): ConnectionStrings__Db</option>
        <option value="dot">Flatten with dots: ConnectionStrings.Db</option>
        <option value="json">Keep each top-level value as a JSON string</option>
        <option value="file">Whole input as one file key</option>
      </select>
      <p id="enc-nested-hint" class="muted small"></p>
    </div>
    <ul id="enc-notes" class="enc-notes"></ul>
    <p id="enc-err" class="status-err" aria-live="polite"></p>
    <div class="table-wrap"><table id="enc-keys"></table></div>
    <div>
      <div class="row"><label for="enc-out">Secret manifest</label><button class="btn ghost" type="button" data-copy="enc-out">Copy</button></div>
      <textarea id="enc-out" class="code tall" readonly></textarea>
    </div>
    <div>
      <div class="row"><label for="enc-cmd">Or with kubectl</label><button class="btn ghost" type="button" data-copy="enc-cmd">Copy</button></div>
      <textarea id="enc-cmd" class="code" readonly></textarea>
    </div>
  </section>
  <script type="application/json" id="sample" set:html={JSON.stringify(sample).replace(/</g, '\\u003c')}></script>
  <script type="application/json" id="snippet-sample" set:html={JSON.stringify(snippetSample).replace(/</g, '\\u003c')}></script>

  <div slot="notes" class="prose">
    <h2>Decode a full Secret or bare <code>KEY: Base64</code> lines</h2>
    <p>You can paste a complete <code>kind: Secret</code> manifest, a <code>kubectl get secret -o yaml</code> list, a <code>data:</code> block, or just the raw <code>KEY: Base64</code> / <code>KEY=Base64</code> lines copied from inside a Secret:</p>
    <pre><code set:text={`  Blob__AccessTier: Q29vbA==
  Blob__AccountUrl: aHR0cHM6Ly9zdGJyYW5kc2FuZGJveDAwMDIuYmxvYi5jb3JlLndpbmRvd3MubmV0`} /></pre>
    <p>Export the decoded values as <code>KEY: value</code> YAML, <code>.env</code> (<code>KEY=VALUE</code>), nested <code>appsettings.json</code> (unflattened on <code>__</code>), or a full Kubernetes <code>Secret</code> with <code>stringData</code>.</p>
    <h2>Base64 is not encryption</h2>
    <p>Anyone who can read the manifest can read the values. Do not commit Secrets to Git. Keep the values in a vault and sync them with External Secrets Operator, Sealed Secrets or the Secrets Store CSI driver.</p>
    <h2>Input formats for Create a Secret</h2>
    <p>The format is detected automatically: <code>.env</code> lines (quoted values may span several lines, so a PEM key can be pasted as is), docker-compose <code>environment:</code> blocks or <code>- KEY=value</code> lists, a JSON object, the output of <code>aws secretsmanager get-secret-value</code> or <code>vault kv get -format=json</code>, YAML maps, .NET <code>appsettings.json</code> (comments and trailing commas are fine) and Azure Functions <code>local.settings.json</code>, where only <code>Values</code> and <code>ConnectionStrings</code> are used. Keys written with <code>:</code>, such as <code>Section:Key</code>, become <code>Section__Key</code>: a colon is not allowed in Secret keys or Linux env var names.</p>
    <p>Nested sections are flattened with <code>__</code> by default, which is how .NET and most config libraries map environment variables to nested settings. Only the sensitive parts (connection strings, keys, passwords) belong in a Secret; URLs and template IDs can go in a ConfigMap.</p>
    <pre><code set:text={`envFrom:
  - secretRef:
      name: app-secrets
# or mount the whole file:
volumeMounts:
  - name: settings
    mountPath: /app/appsettings.Production.json
    subPath: appsettings.json`} /></pre>
    <h2>The trailing newline problem</h2>
    <p><code>echo 'value' | base64</code> encodes a newline at the end, and the app then receives <code>value\n</code>. Passwords that “look right” but fail to authenticate are often this. Use <code>echo -n</code> or <code>printf '%s'</code>. This tool flags values that end with a newline.</p>
    <pre><code set:text={`kubectl get secret app-secrets -o jsonpath='{.data.DB_PASSWORD}' | base64 -d
kubectl create secret tls app-tls --cert=tls.crt --key=tls.key`} /></pre>
  </div>
</ToolShell>

<script>
  import yaml from 'js-yaml';
  import { copyText } from '../../scripts/copy';
  import {
    parseSecretInput,
    checkPairs,
    decodeSecretInput,
    formatDecodedSecrets,
    type Pair,
    type NestedMode,
    type DecodedSecret,
    type DecodedExportFormat,
  } from '../../lib/secret-input';
  const $ = <T extends HTMLElement = HTMLInputElement>(id: string) => document.getElementById(id) as T;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  const b64encode = (s: string) => { let bin = ''; new TextEncoder().encode(s).forEach((b) => (bin += String.fromCharCode(b))); return btoa(bin); };
  const hex = (b: Uint8Array) => Array.from(b.slice(0, 24), (x) => x.toString(16).padStart(2, '0')).join(' ') + (b.length > 24 ? ' …' : '');

  function describe(text: string | undefined): string[] {
    if (text == null) return ['binary'];
    const n: string[] = [];
    if (/\r?\n$/.test(text) && !text.trimEnd().includes('\n')) n.push('ends with a newline');
    if (text !== text.trim() && !/\r?\n$/.test(text)) n.push('leading or trailing spaces');
    if (/-----BEGIN CERTIFICATE-----/.test(text)) n.push('PEM certificate');
    if (/-----BEGIN [A-Z ]*PRIVATE KEY-----/.test(text)) n.push('private key');
    if (/^\s*[{[]/.test(text)) { try { JSON.parse(text); n.push('JSON'); } catch {} }
    if (/^eyJ[\w-]+\.[\w-]+\.[\w-]*$/.test(text.trim())) n.push('JWT');
    if (/^[a-z][a-z0-9+.-]*:\/\/[^\s]*:[^\s]*@/i.test(text.trim())) n.push('URL with credentials');
    return n;
  }

  // Decode
  let decoded: DecodedSecret[] = [];
  let decFmtTouched = false;
  const decFmtSel = $<HTMLSelectElement>('dec-fmt');
  decFmtSel.addEventListener('change', () => {
    decFmtTouched = true;
    renderDecodedOutput();
  });

  function renderDecodedOutput() {
    if (!decoded.length) return;
    const fmt = decFmtSel.value as DecodedExportFormat;
    $<HTMLTextAreaElement>('dec-yaml').value = formatDecodedSecrets(decoded, fmt);
  }

  function decode() {
    const err = $('dec-err'), out = $('dec-out'), wrap = $('dec-yaml-wrap');
    err.textContent = ''; out.innerHTML = ''; wrap.hidden = true; decoded = [];
    const raw = $<HTMLTextAreaElement>('dec-in').value;
    if (!raw.trim()) return;
    try {
      decoded = decodeSecretInput(raw);
    } catch (e) {
      err.textContent = (e as Error).message;
      return;
    }
    if (!decFmtTouched) {
      const allSnippets = decoded.every((d) => d.isSnippet);
      decFmtSel.value = allSnippets ? 'yaml-kv' : 'stringdata';
    }
    render();
    renderDecodedOutput();
    wrap.hidden = false;
  }

  function render() {
    const show = $('reveal').checked;
    const multi = decoded.length > 1;
    let rowIdx = 0;
    $('dec-out').innerHTML = `<thead><tr>${multi ? '<th>Secret</th>' : ''}<th>Key</th><th>Value</th><th>Size</th><th>Notes</th><th></th></tr></thead><tbody>` +
      decoded.flatMap(({ secret, rows }) => rows.map((r) => {
        const idx = rowIdx++;
        const notes = describe(r.text);
        const value = r.text == null ? `<span class="muted">${hex(r.bytes)}</span>`
          : show ? `<pre id="dec-val-${idx}" class="val">${esc(r.text)}</pre>` : `<span id="dec-val-${idx}" class="mask">${'•'.repeat(Math.min(12, Math.max(4, r.text.length)))}</span>`;
        const copyBtn = r.text != null
          ? `<button type="button" class="btn ghost row-copy-btn" data-copy-val="${esc(r.text)}" data-target-id="dec-val-${idx}">Copy</button>`
          : '';
        return `<tr>${multi ? `<td>${esc(secret.metadata?.name ?? '?')}</td>` : ''}<td><code>${esc(r.key)}</code></td><td>${value}</td><td>${r.bytes.length} B</td>
          <td>${notes.map((x) => `<span class="${x.includes('newline') || x.includes('spaces') ? 'status-warn' : 'muted'}">${x}</span>`).join(', ')}</td>
          <td class="act-cell">${copyBtn}</td></tr>`;
      })).join('') + '</tbody>';
  }

  $('dec-out').addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-copy-val]');
    if (!btn) return;
    const targetEl = btn.dataset.targetId ? document.getElementById(btn.dataset.targetId) : null;
    copyText(btn, btn.dataset.copyVal ?? '', targetEl);
  });

  // Encode
  const nestedSel = $<HTMLSelectElement>('enc-nested');
  let nestedTouched = false;
  // Runs before the section's input listener, so encode() sees the user's choice.
  nestedSel.addEventListener('input', () => { nestedTouched = true; });
  const NESTED_HINT: Record<NestedMode, string> = {
    env: 'Load it with envFrom: secretRef. .NET reads ConnectionStrings__Db as ConnectionStrings:Db.',
    dot: 'Keys with dots cannot be env var names in most shells. Use this for apps that read keys from mounted files.',
    json: 'Each top-level section becomes one key holding JSON. The app has to parse it.',
    file: 'Mount the Secret as a volume and point the app at the file (for .NET: appsettings.Production.json with subPath).',
  };
  const shq = (s: string) => `'${s.replace(/'/g, `'\\''`)}'`;
  function encode() {
    const err = $('enc-err'), keys = $('enc-keys'), fmt = $('enc-format');
    err.textContent = ''; keys.innerHTML = ''; fmt.textContent = ''; $('enc-notes').innerHTML = '';
    const name = $('enc-name').value.trim() || 'app-secrets', ns = $('enc-ns').value.trim(), type = $<HTMLSelectElement>('enc-type').value;
    $('enc-kv-wrap').hidden = type === 'kubernetes.io/dockerconfigjson';
    $('enc-reg-wrap').hidden = type !== 'kubernetes.io/dockerconfigjson';
    let pairs: Pair[];
    let fileMode = false;
    let cmd: string;
    const nsFlag = ns ? ` -n ${ns}` : '';
    try {
      if (type === 'kubernetes.io/dockerconfigjson') {
        const server = $('reg-server').value.trim(), user = $('reg-user').value, pass = $('reg-pass').value;
        const auth = b64encode(`${user}:${pass}`);
        pairs = [['.dockerconfigjson', JSON.stringify({ auths: { [server]: { username: user, password: pass, auth } } })]];
        cmd = `kubectl create secret docker-registry ${name}${nsFlag} \\\n  --docker-server=${shq(server)} \\\n  --docker-username=${shq(user)} \\\n  --docker-password=${shq(pass)}`;
      } else {
        const parsed = parseSecretInput($<HTMLTextAreaElement>('enc-kv').value, { nested: nestedTouched ? nestedSel.value as NestedMode : undefined });
        pairs = parsed.pairs;
        fmt.textContent = parsed.format ? `Detected: ${parsed.format}` : '';
        $('enc-nested-wrap').hidden = !parsed.nested;
        if (parsed.nested) {
          if (!nestedTouched) nestedSel.value = parsed.suggested;
          nestedSel.querySelector<HTMLOptionElement>('option[value="file"]')!.textContent = `Whole input as one file key: ${parsed.fileKey}`;
          $('enc-nested-hint').textContent = NESTED_HINT[nestedSel.value as NestedMode];
        }
        fileMode = parsed.nested && nestedSel.value === 'file';
        $('enc-notes').innerHTML = (parsed.notes ?? []).map((n) => `<li>${esc(n)}</li>`).join('');
        if (type === 'kubernetes.io/basic-auth' && pairs.some(([k]) => !['username', 'password'].includes(k)))
          err.textContent = 'basic-auth Secrets use the keys username and password.';
        // kubectl rejects repeated keys, so use the last value of each like the manifest does.
        cmd = `kubectl create secret generic ${name}${nsFlag}${type === 'Opaque' ? '' : ` --type=${type}`}` +
          [...new Map(pairs)].map(([k, v]) => fileMode ? ` \\\n  --from-file=${k}` : ` \\\n  --from-literal=${k}=${shq(v)}`).join('');
      }
    } catch (e) {
      err.textContent = (e as Error).message;
      $<HTMLTextAreaElement>('enc-out').value = ''; $<HTMLTextAreaElement>('enc-cmd').value = '';
      return;
    }
    const issues = checkPairs(pairs);
    if (pairs.length && type !== 'kubernetes.io/dockerconfigjson') {
      const enc = new TextEncoder();
      keys.innerHTML = `<thead><tr><th>Key</th><th>Size</th><th>Notes</th></tr></thead><tbody>` + [...new Map(pairs)].map(([k, v]) => {
        const notes = issues.filter((i) => i.key === k).map((i) => `<span class="status-${i.level === 'error' ? 'err' : 'warn'}">${esc(i.message)}</span>`);
        const lines = v.split('\n').length;
        if (lines > 1) notes.push(`<span class="muted">${lines} lines</span>`);
        return `<tr><td><code>${esc(k)}</code></td><td>${enc.encode(v).length} B</td><td>${[...new Set(notes)].join('<br>')}</td></tr>`;
      }).join('') + '</tbody>';
    }
    const blocking = issues.filter((i) => i.level === 'error');
    const general = issues.filter((i) => !i.key);
    if (general.length) err.textContent = general.map((i) => i.message).join(' ');
    if (blocking.length) {
      if (!err.textContent) err.textContent = 'Fix the keys marked in red. The API server would reject this Secret.';
      $<HTMLTextAreaElement>('enc-out').value = ''; $<HTMLTextAreaElement>('enc-cmd').value = '';
      return;
    }
    const doc = {
      apiVersion: 'v1', kind: 'Secret',
      metadata: { name, ...(ns && { namespace: ns }) },
      type,
      data: Object.fromEntries(pairs.map(([k, v]) => [k, b64encode(v)])),
    };
    $<HTMLTextAreaElement>('enc-out').value = yaml.dump(doc, { lineWidth: -1 });
    $<HTMLTextAreaElement>('enc-cmd').value = cmd + '\n';
  }

  function setMode() {
    const mode = (document.querySelector('input[name="mode"]:checked') as HTMLInputElement).value;
    $('decode').hidden = mode !== 'decode';
    $('encode').hidden = mode !== 'encode';
    if (mode === 'encode') encode();
  }
  document.querySelectorAll('input[name="mode"]').forEach((el) => el.addEventListener('change', setMode));
  $('dec-in').addEventListener('input', decode);
  $('reveal').addEventListener('change', render);
  $('encode').addEventListener('input', encode);
  $('load-sample').addEventListener('click', () => {
    $<HTMLTextAreaElement>('dec-in').value = JSON.parse($('sample').textContent!);
    decFmtTouched = false;
    decode();
  });
  $('load-snippet').addEventListener('click', () => {
    $<HTMLTextAreaElement>('dec-in').value = JSON.parse($('snippet-sample').textContent!);
    $('reveal').checked = true;
    decFmtTouched = false;
    decode();
  });
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) =>
    b.addEventListener('click', () => copyText(b, $<HTMLTextAreaElement>(b.dataset.copy!).value, $(b.dataset.copy!))));
</script>

<style>
  .controls { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .block { display: grid; gap: 0.75rem; }
  .block[hidden] { display: none; }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.75rem 1rem; }
  .grid[hidden] { display: none; }
  .row { display: flex; justify-content: space-between; align-items: end; gap: 1rem; margin-bottom: 0.35rem; flex-wrap: wrap; }
  .row label { margin: 0; font-weight: 700; }
  .row .btn { padding: 0.3rem 0.7rem; font-size: 0.9rem; }
  .row-btns { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .fmt-row { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
  .fmt-select { width: auto; padding: 0.25rem 0.55rem; font-size: 0.85rem; }
  .act-cell { text-align: right; width: 1%; white-space: nowrap; }
  .row-copy-btn { padding: 0.2rem 0.55rem; font-size: 0.8rem; }
  .tall { min-height: 14rem; }
  .small { font-size: 0.85rem; }
  .nested[hidden] { display: none; }
  .enc-notes { margin: 0; padding-left: 1.1rem; color: var(--warn); font-size: 0.95rem; }
  .enc-notes:empty { display: none; }
  .nested p { margin: 0.3rem 0 0; }
  .val { margin: 0; white-space: pre-wrap; word-break: break-all; font-family: var(--font-code); font-size: 0.85rem; }
  @media (max-width: 640px) { .grid { grid-template-columns: 1fr; } }
</style>
