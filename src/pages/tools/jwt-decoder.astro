---
import ToolShell from '../../components/ToolShell.astro';
---
<ToolShell slug="jwt-decoder">
  <div>
    <label for="jwt">Token</label>
    <textarea id="jwt" class="code" spellcheck="false" placeholder="eyJhbGciOi..."></textarea>
  </div>
  <p id="jwt-status" aria-live="polite"></p>
  <div class="two">
    <div><h2>Header</h2><pre class="out" id="jwt-header"></pre></div>
    <div><h2>Payload</h2><pre class="out" id="jwt-payload"></pre></div>
  </div>
  <div id="jwt-times" class="table-wrap"></div>

  <div slot="notes" class="prose notes">
    <h2>Notes</h2>
    <p>The signature is not verified. Decoding only shows what the token claims. To trust a token, verify it against the issuer’s public keys (for Entra ID, the JWKS at the tenant’s <code>/discovery/v2.0/keys</code> endpoint).</p>
  </div>
</ToolShell>

<script>
  const input = document.getElementById('jwt') as HTMLTextAreaElement;
  const status = document.getElementById('jwt-status')!;
  const headerEl = document.getElementById('jwt-header')!;
  const payloadEl = document.getElementById('jwt-payload')!;
  const timesEl = document.getElementById('jwt-times')!;

  const b64urlDecode = (s: string) => {
    const b64 = s.replace(/-/g, '+').replace(/_/g, '/').padEnd(Math.ceil(s.length / 4) * 4, '=');
    const bytes = Uint8Array.from(atob(b64), (c) => c.charCodeAt(0));
    return new TextDecoder().decode(bytes);
  };
  const fmtDate = (sec: number) => {
    const d = new Date(sec * 1000);
    return `${d.toISOString().replace('T', ' ').replace('.000Z', ' UTC')} (local: ${d.toLocaleString()})`;
  };
  const rel = (sec: number) => {
    const diff = Math.round((sec * 1000 - Date.now()) / 60000);
    const abs = Math.abs(diff);
    const txt = abs < 60 ? `${abs} min` : abs < 2880 ? `${Math.round(abs / 60)} h` : `${Math.round(abs / 1440)} days`;
    return diff >= 0 ? `in ${txt}` : `${txt} ago`;
  };

  function run() {
    const raw = input.value.trim().replace(/^Bearer\s+/i, '');
    headerEl.textContent = payloadEl.textContent = timesEl.innerHTML = '';
    status.className = '';
    status.textContent = '';
    if (!raw) return;
    const parts = raw.split('.');
    if (parts.length < 2) {
      status.className = 'status-err';
      status.textContent = 'This does not look like a JWT. A JWT has three parts separated by dots.';
      return;
    }
    try {
      const header = JSON.parse(b64urlDecode(parts[0]));
      const payload = JSON.parse(b64urlDecode(parts[1]));
      headerEl.textContent = JSON.stringify(header, null, 2);
      payloadEl.textContent = JSON.stringify(payload, null, 2);
      const rows: string[] = [];
      for (const [k, label] of [['iat', 'Issued'], ['nbf', 'Valid from'], ['exp', 'Expires']] as const) {
        if (typeof payload[k] === 'number') rows.push(`<tr><th>${label} (${k})</th><td>${fmtDate(payload[k])}</td><td>${rel(payload[k])}</td></tr>`);
      }
      if (rows.length) timesEl.innerHTML = `<table><tbody>${rows.join('')}</tbody></table>`;
      if (typeof payload.exp === 'number') {
        const expired = payload.exp * 1000 < Date.now();
        status.className = expired ? 'status-err' : 'status-ok';
        status.textContent = expired ? `Expired ${rel(payload.exp)}.` : `Valid for now, expires ${rel(payload.exp)}.`;
      } else {
        status.className = 'status-warn';
        status.textContent = 'No exp claim. This token does not expire on its own.';
      }
    } catch {
      status.className = 'status-err';
      status.textContent = 'Could not decode the header or payload. Check that the token was copied in full.';
    }
  }
  input.addEventListener('input', run);
</script>

<style>
  .two { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1.25rem; }
  .two h2 { font-size: 1.05rem; }
  #jwt-status { margin: 0; font-weight: 700; }
  .notes { margin-top: 2rem; }
  @media (max-width: 760px) { .two { grid-template-columns: 1fr; } }
</style>
