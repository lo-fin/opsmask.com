---
import ToolShell from '../../components/ToolShell.astro';
import { PRESETS } from '../../lib/k8s-sa';
const customSample = `- apiGroups: ["apps"]
  resources: ["deployments"]
  verbs: ["get", "list", "patch"]`;
---
<ToolShell slug="k8s-kubeconfig">
  <div class="grid">
    <div><label for="name">Service account</label><input id="name" type="text" class="code" value="ci-deployer" spellcheck="false" /></div>
    <div><label for="ns">Namespace</label><input id="ns" type="text" class="code" value="prod" spellcheck="false" /></div>
    <div><label for="ctx">Cluster context</label><input id="ctx" type="text" class="code" placeholder="current, asked at run time" spellcheck="false" /></div>
  </div>

  <fieldset>
    <legend>Access</legend>
    <div class="grid two">
      <div>
        <label for="preset">Permissions</label>
        <select id="preset">
          {Object.entries(PRESETS).map(([k, p]) => <option value={k}>{p.label}</option>)}
        </select>
        <p id="preset-desc" class="muted small"></p>
      </div>
      <div>
        <span class="lbl">Where</span>
        <label class="check"><input type="radio" name="scope" value="namespace" checked /> Only this namespace</label>
        <label class="check"><input type="radio" name="scope" value="cluster" /> Every namespace</label>
      </div>
    </div>
    <div id="custom-wrap" hidden>
      <label for="custom">Rules (YAML list, as in a Role)</label>
      <textarea id="custom" class="code" spellcheck="false">{customSample}</textarea>
    </div>
  </fieldset>

  <fieldset>
    <legend>Token</legend>
    <label class="check"><input type="radio" name="token" value="short" checked /> Short-lived (recommended)</label>
    <label class="check"><input type="radio" name="token" value="long" /> Long-lived Secret</label>
    <div id="duration-wrap" class="inline">
      <label for="duration">Valid for</label>
      <input id="duration" type="text" class="code" value="24h" spellcheck="false" />
    </div>
  </fieldset>

  <p id="err" class="status-err" aria-live="polite"></p>
  <ul id="warn" class="warn"></ul>

  <div class="tabs" role="tablist">
    <button type="button" role="tab" class="tab" aria-selected="true" data-tab="script">Script</button>
    <button type="button" role="tab" class="tab" aria-selected="false" data-tab="manifests">YAML only</button>
    <button type="button" role="tab" class="tab" aria-selected="false" data-tab="cleanup">Remove later</button>
  </div>
  <div class="out-wrap">
    <div class="row">
      <span id="out-label" class="muted small"></span>
      <span class="actions">
        <a id="rbac-link" class="btn ghost small" href="/tools/k8s-rbac-explainer/">Check permissions</a>
        <button class="btn ghost small" type="button" id="copy">Copy</button>
      </span>
    </div>
    <pre id="out" class="out"></pre>
  </div>

  <div slot="notes" class="prose">
    <h2>How to use it</h2>
    <p>Save the script as <code>create-sa.sh</code> and run <code>bash create-sa.sh</code> with your normal admin access. It shows the cluster and asks before changing anything (set <code>YES=1</code> to skip the question in automation). The token is created on your machine and written straight into the kubeconfig file: it never passes through this page.</p>
    <pre><code set:text={`bash create-sa.sh
KUBECONFIG=./ci-deployer.kubeconfig kubectl get pods`} /></pre>
    <h2>Short-lived or long-lived token?</h2>
    <p>Since Kubernetes 1.24, service accounts no longer get a token Secret automatically, which is why many older guides stop working. <code>kubectl create token</code> issues a token that expires; the API server may cap how long it can be. For CI, create a new token in each run. A Secret of type <code>kubernetes.io/service-account-token</code> gives a token that never expires: only use it when nothing else works, and delete it when you are done.</p>
    <h2>Better options for CI on a managed cluster</h2>
    <p>On AKS, EKS and GKE, CI pipelines can sign in with workload identity or OIDC federation (for example GitHub Actions with <code>azure/login</code> and <code>kubelogin</code>), so there is no token to store or leak. Use a service account kubeconfig when that is not available.</p>
    <h2>Before you share the kubeconfig</h2>
    <p>The file contains a working credential. Send it through a secret store, not chat or email, and run it through the <a href="/tools/k8s-redactor/">redactor</a> before pasting it anywhere for troubleshooting.</p>
  </div>
</ToolShell>

<script>
  import { generate, PRESETS, type Preset, type SaResult } from '../../lib/k8s-sa';
  import { copyText } from '../../scripts/copy';
  const $ = <T extends HTMLElement = HTMLInputElement>(id: string) => document.getElementById(id) as T;
  const radio = (n: string) => (document.querySelector(`input[name="${n}"]:checked`) as HTMLInputElement).value;
  const esc = (s: string) => s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]!);
  let tab = 'script';
  let result: SaResult | null = null;
  const LABELS: Record<string, string> = {
    script: 'bash · run with your admin kubeconfig',
    manifests: 'ServiceAccount and RBAC, for GitOps. Create the token separately.',
    cleanup: 'Removes everything the script created',
  };

  function run() {
    const preset = $<HTMLSelectElement>('preset').value as Preset;
    $('preset-desc').textContent = PRESETS[preset].description;
    $('custom-wrap').hidden = preset !== 'custom';
    $('duration-wrap').hidden = radio('token') !== 'short';
    $('err').textContent = '';
    try {
      result = generate({
        name: $('name').value, namespace: $('ns').value, context: $('ctx').value,
        scope: radio('scope') as 'namespace' | 'cluster', preset, customRules: $<HTMLTextAreaElement>('custom').value,
        token: radio('token') as 'short' | 'long', duration: $('duration').value,
      });
    } catch (e) {
      result = null;
      $('err').textContent = (e as Error).message;
    }
    $('warn').innerHTML = (result?.warnings ?? []).map((w) => `<li>${esc(w)}</li>`).join('');
    // The hash stays in the browser; the RBAC explainer reads it on load.
    if (result) $<HTMLAnchorElement>('rbac-link').href = `/tools/k8s-rbac-explainer/#yaml=${encodeURIComponent(result.rbacYaml)}`;
    show();
  }

  function show() {
    document.querySelectorAll<HTMLButtonElement>('.tab').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.tab === tab)));
    $('out-label').textContent = tab === 'manifests' && radio('token') === 'long'
      ? 'ServiceAccount, RBAC and the token Secret, for GitOps' : LABELS[tab];
    $('out').textContent = result ? result[tab as 'script' | 'manifests' | 'cleanup'] : '';
  }

  document.querySelector('.tool')!.addEventListener('input', run);
  document.querySelectorAll<HTMLButtonElement>('.tab').forEach((b) => b.addEventListener('click', () => { tab = b.dataset.tab!; show(); }));
  $('copy').addEventListener('click', () => copyText($('copy'), $('out').textContent ?? '', $('out')));
  run();
</script>

<style>
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.75rem 1rem; }
  .grid.two { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  fieldset { border: 1px solid var(--line); border-radius: var(--radius-m); padding: 0.75rem 1rem; margin: 0; display: grid; gap: 0.6rem; }
  fieldset legend { font-weight: 700; padding-inline: 0.3rem; }
  fieldset .check { margin-bottom: 0.2rem; }
  [hidden] { display: none !important; }
  .lbl { display: block; font-weight: 700; margin-bottom: 0.35rem; }
  .small { font-size: 0.85rem; }
  #preset-desc { margin: 0.35rem 0 0; }
  .inline { display: inline-flex; gap: 0.5rem; align-items: center; }
  .inline label { margin: 0; font-weight: 400; }
  .inline input { width: 7rem; }
  .warn { margin: 0; padding-left: 1.1rem; color: var(--warn); }
  .warn:empty, #err:empty { display: none; }
  .tabs { display: flex; gap: 0.25rem; border-bottom: 1px solid var(--line); }
  .tab { background: none; border: 0; border-bottom: 3px solid transparent; padding: 0.45rem 0.8rem; font: inherit; font-weight: 700; color: var(--ink-soft); cursor: pointer; }
  .tab[aria-selected='true'] { color: var(--ink); border-bottom-color: var(--mask); }
  .row { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 0.35rem; flex-wrap: wrap; }
  .actions { display: inline-flex; gap: 0.5rem; }
  /* Grid children default to min-width: auto, so a long line would widen the page. */
  .out-wrap { min-width: 0; }
  #out { max-width: 100%; max-height: 32rem; overflow: auto; white-space: pre; word-break: normal; }
  @media (max-width: 700px) { .grid, .grid.two { grid-template-columns: 1fr; } }
</style>
