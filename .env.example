# Copy to .env (gitignored) for local builds and production deploys.
# Never commit .env or real API tokens to version control.

# Public site metadata (optional overrides)
PUBLIC_SITE_URL=https://opsmask.com
PUBLIC_CONTACT_EMAIL=contact@opsmask.com

# Community support links (leave empty to hide)
PUBLIC_KOFI_URL=
PUBLIC_KOFI_WIDGET_ID=
PUBLIC_GITHUB_SPONSORS_URL=

# Advertising provider: none | adsense | carbon | ethicalads
PUBLIC_ADS_PROVIDER=none
PUBLIC_ADSENSE_CLIENT_ID=
PUBLIC_ADSENSE_SLOT_ID=
PUBLIC_CARBON_SERVE=
PUBLIC_CARBON_PLACEMENT=
PUBLIC_ETHICALADS_PUBLISHER=

# Cloudflare CDN Edge Cache Purge (optional, used by `make purge-cache` / `make deploy`)
# CF_API_TOKEN=
# CF_ZONE_ID=
# CF_ZONE_DOMAIN=opsmask.com
